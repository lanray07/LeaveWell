    "Keep the displayed digits, including leading zeroes. Add a photograph and confirm the reading yourself.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بالأرقام الظاهرة، بما فيها الأصفار في البداية. أضف صورة وتحقق من القراءة بنفسك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übernimm die angezeigten Ziffern einschließlich führender Nullen. Füge ein Foto hinzu und prüfe den Zählerstand selbst."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the displayed digits, including leading zeroes. Add a photograph and confirm the reading yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva los dígitos mostrados, incluidos los ceros iniciales. Añade una foto y comprueba la lectura personalmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez les chiffres affichés, y compris les zéros initiaux. Ajoutez une photo et vérifiez vous-même le relevé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरुआती शून्य सहित, दिखाई दे रहे अंक वैसे ही रखें। तस्वीर जोड़ें और रीडिंग खुद जाँचें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertahankan digit yang ditampilkan, termasuk angka nol di awal. Tambahkan foto dan periksa sendiri angka meter tersebut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni le cifre visualizzate, compresi gli zeri iniziali. Aggiungi una foto e verifica personalmente la lettura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先頭のゼロを含め、表示どおりの数字を残してください。写真を追加し、値をご自身で確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞자리의 0을 포함해 표시된 숫자를 그대로 기록하세요. 사진을 추가하고 수치를 직접 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar de weergegeven cijfers, inclusief voorloopnullen. Voeg een foto toe en controleer de meterstand zelf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj wyświetlane cyfry, także początkowe zera. Dodaj zdjęcie i samodzielnie sprawdź odczyt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha os dígitos exibidos, incluindo os zeros à esquerda. Adicione uma foto e confira a leitura pessoalmente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behåll de visade siffrorna, även inledande nollor. Lägg till ett foto och kontrollera själv mätarställningen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baştaki sıfırlar dahil, görüntülenen rakamları koruyun. Bir fotoğraf ekleyin ve okumayı kendiniz doğrulayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留显示的全部数字，包括开头的零。添加照片，并亲自核对读数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留顯示的所有數字，包括開頭的零。新增照片，並親自核對讀數。"
          }
        }
      }
    },
