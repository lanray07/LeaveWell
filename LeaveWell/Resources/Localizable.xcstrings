    "Record each access item and who received it. Only mark handover when it has happened.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل كل وسيلة دخول ومن استلمها. لا تحدد أنها سُلّمت إلا بعد حدوث التسليم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse jedes Zugangsmittel und seine empfangende Person. Vermerke die Übergabe erst, wenn sie stattgefunden hat."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Record each access item and who received it. Only mark handover when it has happened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra cada elemento de acceso y quién lo recibió. Marca la entrega solo cuando se haya realizado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consignez chaque moyen d’accès et son destinataire. N’indiquez sa remise qu’une fois celle-ci effectuée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रवेश के हर साधन और उसे पाने वाले का नाम दर्ज करें। हस्तांतरण होने के बाद ही उसे पूरा चिह्नित करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catat setiap sarana akses dan siapa yang menerimanya. Tandai penyerahan hanya setelah dilakukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra ogni mezzo di accesso e chi lo ha ricevuto. Segna la consegna solo dopo che è avvenuta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵などの入室手段と受取人を記録します。実際に引き渡してから完了にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 출입 수단과 받은 사람을 기록하세요. 실제로 인계한 뒤에만 인계 완료로 표시하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg elk toegangsmiddel vast en wie het ontving. Markeer de overdracht pas wanneer die heeft plaatsgevonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz każdy środek dostępu i osobę, która go otrzymała. Oznacz przekazanie dopiero po jego dokonaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre cada meio de acesso e quem o recebeu. Marque a entrega apenas depois que ela ocorrer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokumentera varje tillträdesmedel och vem som tog emot det. Markera överlämningen först när den har skett."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her erişim aracını ve onu teslim alan kişiyi kaydedin. Teslimi yalnızca gerçekleştikten sonra işaretleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录每件出入凭证及其接收人。仅在实际完成交接后标记已交接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄每件出入憑證及其接收人。只有在實際完成交接後，才標記為已交接。"
          }
        }
      }
    },
