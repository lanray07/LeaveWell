    "A calm move starts here.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مغادرة هادئة تبدأ من هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein entspannter Auszug beginnt hier."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A calm move starts here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una mudanza tranquila empieza aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un départ serein commence ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक सुकून भरी शुरुआत यहीं से।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindah dengan tenang dimulai di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un trasloco sereno inizia qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "落ち着いた退去準備は、ここから。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차분한 퇴거 준비는 여기서 시작하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een rustige verhuizing begint hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spokojna wyprowadzka zaczyna się tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma mudança tranquila começa aqui."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En lugn flytt börjar här."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakin bir taşınma burada başlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从这里开始，安心准备退租。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從這裡開始，安心準備退租。"
          }
        }
      }
    },
