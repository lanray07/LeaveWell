    "Two keys handed over at the agreed checkout. Demo record.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تسليم مفتاحين في موعد التسليم المتفق عليه. سجل توضيحي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Schlüssel beim vereinbarten Auszugstermin übergeben. Demo-Eintrag."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Two keys handed over at the agreed checkout. Demo record."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos llaves entregadas en la cita de salida acordada. Registro de demostración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux clés remises lors du rendez-vous de sortie convenu. Fiche de démonstration."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तय निरीक्षण के समय दो चाबियाँ सौंप दी गईं। डेमो रिकॉर्ड।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dua kunci diserahkan pada pemeriksaan akhir yang disepakati. Catatan demo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due chiavi consegnate all’appuntamento concordato per la riconsegna. Registrazione dimostrativa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合意した退去確認時に鍵を2本引き渡しました。デモ記録です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약속한 퇴거 점검 때 열쇠 두 개를 전달했습니다. 데모 기록입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twee sleutels overhandigd tijdens de afgesproken oplevering. Demorecord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwa klucze przekazane podczas uzgodnionego zdania lokalu. Wpis demonstracyjny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Duas chaves entregues na vistoria de saída combinada. Registro de demonstração."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Två nycklar överlämnade vid den avtalade utflyttningskontrollen. Demopost."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kararlaştırılan çıkış kontrolünde iki anahtar teslim edildi. Demo kaydı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在约定的退租检查时交接了两把钥匙。演示记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在約定的退租檢查時交接了兩把鑰匙。示範紀錄。"
          }
        }
      }
    },
