    "Review your evidence before exporting. Anyone you share the PDF with can keep a copy.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع أدلتك قبل التصدير. يمكن لأي شخص تشاركه ملف PDF الاحتفاظ بنسخة منه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe deine Belege vor dem Export. Jede Person, mit der du die PDF teilst, kann eine Kopie behalten."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Review your evidence before exporting. Anyone you share the PDF with can keep a copy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa las pruebas antes de exportarlas. Quien reciba el PDF podrá conservar una copia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez vos preuves avant l’exportation. Toute personne avec qui vous partagez le PDF peut en conserver une copie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्यात करने से पहले सबूत जाँचें। जिसके साथ आप PDF साझा करते हैं, वह उसकी कॉपी रख सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinjau bukti sebelum mengekspor. Siapa pun yang menerima PDF dapat menyimpan salinannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla le prove prima di esportarle. Chiunque riceva il PDF può conservarne una copia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出す前に証拠を確認してください。PDFを共有した相手はコピーを保管できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보내기 전에 증거를 검토하세요. PDF를 받은 사람은 사본을 보관할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer je bewijs voor het exporteren. Iedereen met wie je de PDF deelt, kan een kopie bewaren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź dowody przed eksportem. Każda osoba, której udostępnisz PDF, może zachować kopię."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise as evidências antes de exportar. Qualquer pessoa com quem você compartilhar o PDF poderá guardar uma cópia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Granska underlagen före export. Alla du delar PDF-filen med kan behålla en kopia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dışa aktarmadan önce kanıtlarınızı inceleyin. PDF’yi paylaştığınız herkes bir kopyasını saklayabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出前请核查凭证。收到 PDF 的任何人都可以保留副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯出前請確認佐證。收到 PDF 的任何人都可以保留副本。"
          }
        }
      }
    },
