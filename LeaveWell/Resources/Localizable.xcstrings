    "Timestamps are recorded from the device clock. Imported items may have no known capture time. SHA-256 hashes identify stored file bytes; they do not certify when, where or by whom evidence was captured.": {
      "extractionState": "manual",
      "localizations": {
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Timestamps are recorded from the device clock. Imported items may have no known capture time. SHA-256 hashes identify stored file bytes; they do not certify when, where or by whom evidence was captured."
          }
        }
      }
    },
    "To the best of my knowledge, this record reflects the property and information I documented at the stated dates and times.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على حد علمي، يعكس هذا السجل العقار والمعلومات التي وثّقتها في التواريخ والأوقات المحددة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach bestem Wissen gibt dieser Eintrag die Wohnung und die von mir zu den genannten Zeitpunkten dokumentierten Informationen wieder."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To the best of my knowledge, this record reflects the property and information I documented at the stated dates and times."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Según mi leal saber y entender, este registro refleja la vivienda y la información que documenté en las fechas y horas indicadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À ma connaissance, ce dossier reflète le logement et les informations que j’ai documentés aux dates et heures indiquées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेरी जानकारी के अनुसार, यह रिकॉर्ड संपत्ति और उन जानकारियों को दर्शाता है जिन्हें मैंने बताई गई तारीखों और समय पर दर्ज किया था।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepengetahuan saya, catatan ini menggambarkan properti dan informasi yang saya dokumentasikan pada tanggal dan waktu yang disebutkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per quanto a mia conoscenza, questa registrazione rispecchia l’alloggio e le informazioni che ho documentato nelle date e negli orari indicati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私の知る限り、この記録は記載の日時に私が記録した物件の状態および情報を反映しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제가 아는 한, 이 기록은 명시된 날짜와 시간에 제가 기록한 주택과 정보를 반영합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naar mijn beste weten geeft dit record de woning en de informatie weer die ik op de genoemde datums en tijdstippen heb vastgelegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Według mojej najlepszej wiedzy ten wpis odzwierciedla nieruchomość i informacje udokumentowane przeze mnie we wskazanych dniach i godzinach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até onde sei, este registro reflete o imóvel e as informações que documentei nas datas e nos horários indicados."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Såvitt jag vet återger denna post bostaden och de uppgifter som jag dokumenterat vid angivna datum och tider."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildiğim kadarıyla bu kayıt, belirtilen tarih ve saatlerde belgelediğim mülkü ve bilgileri yansıtır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "据我所知，本记录反映了我在所述日期和时间记录的房产及相关信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "據我所知，本紀錄反映了我在所述日期和時間記錄的房產及相關資訊。"
          }
        }
      }
    },
