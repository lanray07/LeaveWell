    "Your report includes the evidence you selected, room records, readings, access items and supporting documents.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشمل تقريرك الأدلة المختارة وسجلات الغرف والقراءات ووسائل الدخول والمستندات الداعمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Bericht enthält die ausgewählten Belege, Raumeinträge, Zählerstände, Zugangsmittel und ergänzenden Dokumente."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your report includes the evidence you selected, room records, readings, access items and supporting documents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El informe incluye las pruebas seleccionadas, los registros de habitaciones, las lecturas, los elementos de acceso y los documentos justificativos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre rapport rassemble les preuves sélectionnées, les fiches des pièces, les relevés, les moyens d’accès et les documents justificatifs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिपोर्ट में चुने गए सबूत, कमरों के रिकॉर्ड, रीडिंग, प्रवेश के साधन और सहायक दस्तावेज़ शामिल हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan mencakup bukti yang dipilih, catatan ruangan, angka meter, sarana akses, dan dokumen pendukung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il report comprende le prove selezionate, le schede delle stanze, le letture, i mezzi di accesso e i documenti di supporto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した証拠、部屋の記録、メーター値、鍵などの入室手段、関連書類をレポートに含めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보고서에는 선택한 증거, 방별 기록, 계량기 수치, 출입 수단 및 관련 문서가 포함됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je rapport bevat de geselecteerde bewijsstukken, kamerrecords, meterstanden, toegangsmiddelen en ondersteunende documenten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raport obejmuje wybrane dowody, wpisy dotyczące pomieszczeń, odczyty, środki dostępu i dokumenty uzupełniające."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu relatório inclui as evidências selecionadas, os registros dos cômodos, as leituras, os meios de acesso e os documentos de apoio."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapporten innehåller valda underlag, rumsanteckningar, mätarställningar, tillträdesmedel och kompletterande dokument."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Raporunuz seçtiğiniz kanıtları, oda kayıtlarını, okumaları, erişim araçlarını ve destekleyici belgeleri içerir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报告包含你选定的凭证、房间记录、表计读数、出入凭证和支持文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "報告包含你選定的佐證、房間紀錄、錶計讀數、出入憑證及相關文件。"
          }
        }
      }
    },
