    "The property address, tenant name and contributor names appear in the report. Imported documents may contain private information.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر عنوان العقار واسم المستأجر وأسماء المساهمين في التقرير. قد تحتوي المستندات المستوردة على معلومات خاصة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wohnungsadresse sowie die Namen der Mietenden und Erfassenden erscheinen im Bericht. Importierte Dokumente können private Angaben enthalten."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The property address, tenant name and contributor names appear in the report. Imported documents may contain private information."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El informe muestra la dirección de la vivienda, el nombre del inquilino y los nombres de los autores. Los documentos importados pueden contener información privada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rapport contient l’adresse du logement, le nom du locataire et ceux des auteurs. Les documents importés peuvent contenir des informations privées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिपोर्ट में संपत्ति का पता, किरायेदार और योगदानकर्ताओं के नाम आते हैं। आयात किए गए दस्तावेज़ों में निजी जानकारी हो सकती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat properti, nama penyewa, dan nama para pencatat muncul dalam laporan. Dokumen yang diimpor mungkin berisi informasi pribadi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel report compaiono l’indirizzo dell’alloggio, il nome dell’inquilino e i nomi degli autori. I documenti importati possono contenere informazioni private."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "物件の住所、借主の氏名、記録者の氏名はレポートに表示されます。読み込んだ書類には個人情報が含まれる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주택 주소, 임차인 이름 및 기록자 이름이 보고서에 표시됩니다. 가져온 문서에는 개인 정보가 포함될 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het woningadres, de naam van de huurder en de namen van de auteurs staan in het rapport. Geïmporteerde documenten kunnen privégegevens bevatten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W raporcie pojawiają się adres nieruchomości, imię i nazwisko najemcy oraz dane autorów. Importowane dokumenty mogą zawierać prywatne informacje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O endereço do imóvel, o nome do inquilino e os nomes dos autores aparecem no relatório. Os documentos importados podem conter informações privadas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bostadens adress, hyresgästens namn och dokumenterarnas namn visas i rapporten. Importerade dokument kan innehålla privata uppgifter."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mülkün adresi, kiracının adı ve kaydedenlerin adları raporda yer alır. İçe aktarılan belgeler özel bilgiler içerebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报告中会显示房产地址、租客姓名和记录人姓名。导入的文件可能包含私人信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "報告中會顯示房產地址、租客姓名和記錄者姓名。匯入的文件可能包含私人資訊。"
          }
        }
      }
    },
