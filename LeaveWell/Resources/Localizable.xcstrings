    "Work through each room, explain changes, then review readings and access handover. Saved work stays available as you go.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تفقد كل غرفة، ووضّح التغييرات، ثم راجع القراءات وتسليم وسائل الدخول. تبقى المعلومات المحفوظة متاحة طوال الخطوات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehe Raum für Raum vor, erläutere Veränderungen und prüfe dann Zählerstände und Schlüsselübergabe. Gespeicherte Einträge bleiben dabei verfügbar."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Work through each room, explain changes, then review readings and access handover. Saved work stays available as you go."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa cada habitación, explica los cambios y comprueba las lecturas y la entrega de llaves. Lo que guardes seguirá disponible durante todo el proceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcourez chaque pièce, décrivez les changements, puis vérifiez les relevés et la remise des clés. Vos données enregistrées restent accessibles à chaque étape."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर कमरा जाँचें, बदलाव समझाएँ और फिर मीटर रीडिंग तथा प्रवेश के साधनों का हस्तांतरण जाँचें। सहेजा गया काम हर चरण में उपलब्ध रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa setiap ruangan, jelaskan perubahan, lalu tinjau angka meter dan penyerahan sarana akses. Data yang disimpan tetap tersedia di setiap tahap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla ogni stanza, descrivi i cambiamenti, poi verifica le letture e la consegna delle chiavi. I dati salvati restano disponibili durante tutto il percorso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "部屋ごとに確認し、変化を説明してから、メーター値と鍵などの引き渡しを確認します。保存した内容は各段階で参照できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방마다 확인하고 변화를 설명한 뒤 계량기 수치와 출입 수단 인계를 검토하세요. 저장한 내용은 각 단계에서 계속 확인할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop elke kamer na, beschrijf veranderingen en controleer daarna meterstanden en de overdracht van toegangsmiddelen. Opgeslagen gegevens blijven onderweg beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź każde pomieszczenie, opisz zmiany, a potem zweryfikuj odczyty i przekazanie środków dostępu. Zapisane dane pozostają dostępne na każdym etapie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira cada cômodo, explique as mudanças e revise as leituras e a entrega dos meios de acesso. Os dados salvos continuam disponíveis em cada etapa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå igenom varje rum, beskriv förändringar och kontrollera sedan mätarställningar och överlämning av tillträdesmedel. Sparade uppgifter finns kvar under hela arbetet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her odayı kontrol edin, değişiklikleri açıklayın, ardından sayaç okumalarını ve erişim araçlarının teslimini inceleyin. Kaydettiğiniz bilgiler her aşamada kullanılabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逐一检查房间，说明变化，再核查表计读数和出入凭证交接。已保存的内容在整个过程中都可查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "逐一檢查房間，說明變化，再確認錶計讀數和出入憑證交接。已儲存的內容在整個過程中都能查看。"
          }
        }
      }
    },
